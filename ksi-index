#!/usr/bin/env python3
"""Build or refresh the session index.

Usage:
  ksi-index                 # incremental: only re-parse changed session files
  ksi-index --full          # rebuild from scratch
  ksi-index --verbose       # list each session as it is indexed
"""

import argparse
import json
import os
import sys

# realpath, not abspath: these entry points are invoked through symlinks on PATH,
# where abspath would add the link's directory rather than the installed one.
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))
# Keep __pycache__ out of the install directory: when installed as a skill it lives
# inside ~/.kiro, which is a git repo. Set before importing ksi so it takes effect.
sys.pycache_prefix = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "kiro-session-index", "pycache")

from ksi import index as I  # noqa: E402


def main():
    p = argparse.ArgumentParser(prog="ksi-index", description=__doc__,
                               formatter_class=argparse.RawDescriptionHelpFormatter)
    p.add_argument("--full", action="store_true", help="discard and rebuild the index")
    p.add_argument("--verbose", "-v", action="store_true")
    p.add_argument("--json", action="store_true")
    p.add_argument("--db", help=f"index path (default {I.DEFAULT_DB})")
    p.add_argument("--sessions", help=f"source logs (default {I.DEFAULT_SESSIONS})")
    args = p.parse_args()

    src = args.sessions or I._sessions_dir()
    if not os.path.isdir(src):
        print(f"error: no session directory at {src}", file=sys.stderr)
        return 2

    stats = I.update(db_path=args.db, sessions_dir=args.sessions,
                     full=args.full, verbose=args.verbose)
    if args.json:
        print(json.dumps(stats, indent=2))
    else:
        if not stats["files_indexed"] and not stats["sessions_removed"]:
            print(f"index already current ({stats['elapsed_s']}s)")
        else:
            print(f"indexed {stats['files_indexed']} file(s) in {stats['elapsed_s']}s: "
                  f"{stats['messages']} messages, {stats['tool_calls']} tool calls, "
                  f"{stats['tool_results']} tool results")
            if stats["sessions_removed"]:
                print(f"removed {stats['sessions_removed']} vanished session(s)")
            if stats["outputs_gc"]:
                print(f"garbage-collected {stats['outputs_gc']} orphaned output(s)")
        if stats["bad_lines"]:
            print(f"warning: skipped {stats['bad_lines']} unparseable line(s)",
                  file=sys.stderr)
        if stats["files_failed"]:
            print(f"error: {stats['files_failed']} session(s) could not be indexed; "
                  f"the rest of the index is up to date:", file=sys.stderr)
            for session_id, reason in stats["failures"]:
                print(f"  {session_id}: {reason}", file=sys.stderr)
            return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
