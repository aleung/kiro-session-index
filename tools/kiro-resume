#!/usr/bin/env python3
"""Pick a past Kiro session and resume it. See `kiro-resume --help`."""

import os
import sys

# realpath, not abspath: this is invoked through a symlink on PATH, and abspath
# would add the link's directory -- which has no ksi package in it -- rather than
# the installed one. CPython also resolves the link when computing sys.path[0], so
# today either spelling happens to work; this one works on purpose.
#
# The package sits beside this file once installed, and one level up in the source
# repo, where this file lives in tools/. Take whichever actually holds it, so the
# tool is runnable from a checkout as well as from the install.
_here = os.path.dirname(os.path.realpath(__file__))
for _candidate in (_here, os.path.dirname(_here)):
    if os.path.isdir(os.path.join(_candidate, "ksi")):
        sys.path.insert(0, _candidate)
        break
# Keep __pycache__ out of the install directory: when installed as a skill it lives
# inside ~/.kiro, which is a git repo. Set before importing ksi so it takes effect.
sys.pycache_prefix = os.path.join(
    os.environ.get("XDG_CACHE_HOME", os.path.expanduser("~/.cache")),
    "kiro-session-index", "pycache")

from ksi import resume  # noqa: E402

if __name__ == "__main__":
    sys.exit(resume.main())
